  "machine_cases": [
    {
      "id": "ask_checkpoint_real_validation_head_pick",
      "parsed_program": [
        {
          "name": "ask",
          "args": {
            "prompt": "Continue with metadata",
            "schema": "{\"type\":\"object\",\"properties\":{\"decision\":{\"type\":\"string\",\"enum\":[\"continue\",\"revise\"]},\"label\":{\"type\":\"string\"},\"extra\":{\"type\":\"boolean\"}},\"required\":[\"decision\",\"label\"],\"additionalProperties\":false}",
            "subject-from-stdin": true
          }
        },
        {
          "name": "head",
          "args": {
            "n": 1
          }
        },
        {
          "name": "pick",
          "args": {
            "_": [
              "decision,label"
            ]
          }
        }
      ],
      "input_json": "[{\"title\":\"Draft\"}]",
      "input_kind": "array",
      "options": {},
      "expected_checkpoint_mode": "same_stage",
      "expected_checkpoint_stage_index": 0,
      "expected_checkpoint_subject": {
        "text": "{\"title\":\"Draft\"}"
      },
      "expected_checkpoint_replay_items_json": "[{\"title\":\"Draft\"}]",
      "response_json": "{\"decision\":\"continue\",\"label\":\"Ready\",\"extra\":true}",
      "expected_result_items_json": "[{\"decision\":\"continue\",\"label\":\"Ready\"}]",
      "expected_result_rendered": false,
      "expected_result_rendered_items": [],
      "expected_result_stdout": "",
      "expected_request_boundaries_before_checkpoint": [
        {
          "kind": "compile_schema",
          "boundary": "ask_constructor"
        },
        {
          "kind": "compile_schema",
          "boundary": "request_metadata"
        }
      ],
      "expected_request_boundaries_after_resume": [
        {
          "kind": "compile_schema",
          "boundary": "resume_metadata"
        },
        {
          "kind": "compile_schema",
          "boundary": "saved_response"
        },
        {
          "kind": "validate_response",
          "boundary": "saved_response"
        },
        {
          "kind": "compile_schema",
          "boundary": "ask_constructor"
        },
        {
          "kind": "compile_schema",
          "boundary": "request_metadata"
        },
        {
          "kind": "compile_schema",
          "boundary": "request_response"
        },
        {
          "kind": "validate_response",
          "boundary": "request_response"
        }
      ],
      "rationale": "Upstream ask yields exactly the validated response; public Machine starts a fresh same-stage segment and existing head/pick retains projected fields. Fulfill every request via actual helper and exact pending ID, never blanket fixture acknowledgement."
    }
  ],
