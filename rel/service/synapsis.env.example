# Required for Phoenix sessions and cookies.
# Generate with: openssl rand -base64 64
SECRET_KEY_BASE=

# Required for provider API key encryption.
# Generate with: openssl rand -base64 32
SYNAPSIS_ENCRYPTION_KEY=

# Public host and local listen port. The HTTP listener binds to 127.0.0.1
# unless PHX_IP is explicitly set to another IPv4 or IPv6 address.
PHX_HOST=localhost
PORT=4657

# WARNING: Synapsis v0.1.3 does not authenticate remote HTTP or LiveView access.
# Setting PHX_IP=0.0.0.0 or PHX_IP=:: exposes the local agent to the network.
# PHX_IP=127.0.0.1
