<!DOCTYPE html>
<html lang="en" data-theme="sunshine">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · Synapsis">{assigns[:page_title] || "Synapsis"}</.live_title>
    <link rel="icon" type="image/png" href={~p"/favicon.png"} />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link
      phx-track-static
      rel="stylesheet"
      href={
        DuskmoonBundler.static_path(SynapsisServer.Endpoint, "/assets/css/app.css",
          profile: :synapsis_web
        )
      }
    />
    <script>
      // Apply the saved mode before first paint; missing/legacy values follow the system.
      (function() {
        var theme;
        try { theme = localStorage.getItem("theme"); } catch (_) {}
        if (theme !== "sunshine" && theme !== "moonlight") {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "moonlight" : "sunshine";
        }
        document.documentElement.setAttribute("data-theme", theme);
        document.documentElement.style.colorScheme = theme === "moonlight" ? "dark" : "light";
      })();
    </script>
    <script
      defer
      phx-track-static
      type="module"
      src={
        DuskmoonBundler.static_path(SynapsisServer.Endpoint, "/assets/js/app.js",
          profile: :synapsis_web
        )
      }
    >
    </script>
  </head>
  <body class="bg-surface text-on-surface min-h-screen overflow-x-hidden">
    {@inner_content}
  </body>
</html>
