<!DOCTYPE html>
<html lang="en" data-theme="moonlight">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>Synapsis</title>
    <link rel="icon" type="image/png" href={~p"/favicon.png"} />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link
      phx-track-static
      rel="stylesheet"
      href={
        DuskmoonBundler.static_path(SynapsisServer.Endpoint, "/assets/css/app.css",
          profile: :synapsis_web
        )
      }
    />
    <script>
      // Restore saved theme before first paint to avoid flash.
      // Validate against known themes to avoid applying a stale/invalid value
      // that would leave all CSS theme variables unresolved.
      (function() {
        var valid = ["sunshine", "moonlight"];
        var t = localStorage.getItem("theme");
        if (t && valid.indexOf(t) >= 0) {
          document.documentElement.setAttribute("data-theme", t);
        } else if (t) {
          localStorage.removeItem("theme");
        }
      })();
    </script>
    <script
      defer
      phx-track-static
      type="module"
      src={
        DuskmoonBundler.static_path(SynapsisServer.Endpoint, "/assets/js/app.js",
          profile: :synapsis_web
        )
      }
    >
    </script>
    {raw(
      DuskmoonBundler.Preload.tags(SynapsisServer.Endpoint, "/assets/js/app.js",
        profile: :synapsis_web
      )
    )}
  </head>
  <body class="bg-surface text-on-surface min-h-screen overflow-x-hidden">
    {@inner_content}
  </body>
</html>
